{
  "expo": {
    "name": "Shellbell",
    "slug": "shellbell",
    "scheme": "shellbell",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "dev.bilalahmad.shellbell",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the pairing QR shown by your computer."
      }
    },
    "android": {
      "package": "dev.bilalahmad.shellbell",
      "permissions": ["CAMERA", "VIBRATE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR shown by your computer.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      ["expo-notifications", { "color": "#10B981" }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#000000",
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/JetBrainsMonoNerdFont-Regular.ttf",
              "./assets/fonts/JetBrainsMonoNerdFont-Bold.ttf",
              "./assets/fonts/JetBrainsMonoNerdFont-Italic.ttf",
              "./assets/fonts/JetBrainsMonoNerdFont-BoldItalic.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "JetBrainsMonoNF-Regular",
                "fontDefinitions": [
                  { "path": "./assets/fonts/JetBrainsMonoNerdFont-Regular.ttf", "weight": 400 }
                ]
              },
              {
                "fontFamily": "JetBrainsMonoNF-Bold",
                "fontDefinitions": [
                  { "path": "./assets/fonts/JetBrainsMonoNerdFont-Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "JetBrainsMonoNF-Italic",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMonoNerdFont-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  }
                ]
              },
              {
                "fontFamily": "JetBrainsMonoNF-BoldItalic",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMonoNerdFont-BoldItalic.ttf",
                    "weight": 700,
                    "style": "italic"
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "extra": { "eas": { "projectId": "REPLACE_AFTER_eas_init" } }
  }
}
